# docker-compose environment for LinkedEye.
#   cp deploy/compose.env.example .env    then fill in the values marked REQUIRED.
# The same file feeds the web, probes and migrate containers (env_file) and compose variable substitution
# (database password, image tag, published ports). Never commit .env. Full reference: docs/DEPLOYMENT.md.

# ---- required -------------------------------------------------------------------------------------------
# REQUIRED (compose refuses to start while empty):  python -c "import secrets; print(secrets.token_urlsafe(50))"
LINKEDEYE_SECRET_KEY=
LINKEDEYE_DEBUG=false
# Public host name(s) users type, plus "web" (Alertmanager posts to http://web:8000) and "localhost"
# (container health checks and http://localhost:8000 on the host).
LINKEDEYE_ALLOWED_HOSTS=linkedeye.example.internal,web,localhost
LINKEDEYE_CSRF_TRUSTED_ORIGINS=https://linkedeye.example.internal,http://localhost:8000

# ---- database (the bundled "db" service: PostgreSQL 16) --------------------------------------------------
# The password also initialises the db container on first start. Changing it later does NOT change the
# password inside an existing volume (use ALTER USER, see docs/DEPLOYMENT.md).
# REQUIRED (compose refuses to start while empty).
LINKEDEYE_DB_PASSWORD=
LINKEDEYE_DB_NAME=linkedeye
LINKEDEYE_DB_USER=linkedeye
# To use an external server instead, set these and stop the db service (docker compose up web probes):
# LINKEDEYE_DB_ENGINE=django.db.backends.postgresql      # or django.db.backends.mysql (image built with mysql)
# LINKEDEYE_DB_HOST=postgres.fs-linkedeye.internal
# LINKEDEYE_DB_PORT=5432

# ---- console ----------------------------------------------------------------------------------------------
LINKEDEYE_TENANT=default
LINKEDEYE_TIME_ZONE=Asia/Kolkata
LINKEDEYE_LOG_LEVEL=INFO

# ---- probes (run_probes) ------------------------------------------------------------------------------------
# Private/loopback targets are refused unless listed (SSRF guard), e.g. 10.10.0.0/16,10.20.0.0/16
LINKEDEYE_PROBE_ALLOWED_PRIVATE_CIDRS=
LINKEDEYE_PROBE_TIMEOUT=10
LINKEDEYE_PROBE_WORKERS=8
LINKEDEYE_PROBE_RETENTION_DAYS=30
# LINKEDEYE_LOG_RETENTION_DAYS=14
# LINKEDEYE_TELEMETRY_ALERT_RETENTION_DAYS=90
# LINKEDEYE_AUTOMATION_RETENTION_DAYS=90

# ---- notifications for critical / warning events -----------------------------------------------------------
# NOTE: a variable that is present but empty replaces the setting's default with "" (for numbers that is a
# start-up error). Comment a line out to keep the default instead of leaving it empty.
LINKEDEYE_NOTIFY_WEBHOOK_URLS=
LINKEDEYE_NOTIFY_EMAILS=
# LINKEDEYE_NOTIFY_SEVERITIES=critical,warning
# LINKEDEYE_EMAIL_HOST=smtp.example.internal
# LINKEDEYE_EMAIL_PORT=587
# LINKEDEYE_EMAIL_HOST_USER=
# LINKEDEYE_EMAIL_HOST_PASSWORD=
# LINKEDEYE_EMAIL_USE_TLS=true
LINKEDEYE_DEFAULT_FROM_EMAIL=linkedeye@example.internal

# ---- integrations (optional; pages show "not connected" while unset) ---------------------------------------
# With `docker compose --profile observability up -d`, point the console at the bundled Prometheus:
# LINKEDEYE_PROMETHEUS_URL=http://prometheus:9090
LINKEDEYE_PROMETHEUS_URL=
# Bearer token Alertmanager sends to /api/v1/alertmanager/. The webhook is disabled (503) while empty.
# REQUIRED for the observability profile:  python -c "import secrets; print(secrets.token_urlsafe(32))"
LINKEDEYE_ALERTMANAGER_WEBHOOK_TOKEN=
LINKEDEYE_LOG_INGEST_TOKEN=
LINKEDEYE_STACKSTORM_URL=
LINKEDEYE_STACKSTORM_API_KEY=
LINKEDEYE_INCIDENT_AUTO_CREATE=true
LINKEDEYE_NAGIOS_URL=
LINKEDEYE_NAGIOS_USER=
LINKEDEYE_NAGIOS_PASSWORD=
# LINKEDEYE_PROMETHEUS_TIMEOUT=8
# LINKEDEYE_NAGIOS_TIMEOUT=10

# ---- compose-only knobs (read by docker-compose.yml, not by the application) --------------------------------
# Image to run; `docker compose build` tags the local build with this name.
LINKEDEYE_IMAGE=linkedeye:9.0
# Address:port published on the host for the console. Keep 127.0.0.1 and put a TLS reverse proxy in front;
# use 0.0.0.0:8000 only on a trusted network.
WEB_PUBLISH=127.0.0.1:8000
# Proxies whose X-Forwarded-Proto gunicorn trusts (your reverse proxy's address as seen by the container).
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1,::1
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
PROMETHEUS_PUBLISH=127.0.0.1:9090
ALERTMANAGER_PUBLISH=127.0.0.1:9093
PROMETHEUS_RETENTION=15d
